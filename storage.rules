rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email == "devanshdiwan97@gmail.com")
      );
    }

    // Profile photos
    match /users/{userId}/profile/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // Book covers
    match /books/{bookId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Notices attachments
    match /notices/{noticeId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Fee receipts
    match /fees/{feeId}/receipts/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Study materials
    match /studyMaterials/{materialId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
